# --- Lightspeed (from the Developer Portal + your store address) ---
LS_DOMAIN_PREFIX=yourstore            # the part before .retail.lightspeed.app
LS_CLIENT_ID=
LS_CLIENT_SECRET=

# --- Where this service is reachable on the internet (https) ---
PUBLIC_URL=https://rewards.example.com

# --- Secrets you make up (long random strings; `openssl rand -hex 24`) ---
APP_KEY=            # baked into the iPad app
ADMIN_KEY=          # only you; used once to connect Lightspeed
WEBHOOK_TOKEN=      # becomes part of the webhook URL
STAFF_PIN=          # optional; only used if REQUIRE_STAFF_PIN=true
# REQUIRE_STAFF_PIN=true   # uncomment to make staff enter a PIN before points can be redeemed

# --- Optional ---
PORT=3000
DB_PATH=./data/rewards.db
MIN_FIRST_SALE=0    # minimum pre-tax first sale (in dollars) before the 100-point bonus is credited
